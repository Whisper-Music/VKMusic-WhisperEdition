#WMT 1
# Ashen Inventory — тема в духе экрана инвентаря мрачных фэнтези-RPG (вдохновлено Dark Souls Remastered).
# Всё своё: процедурный фон (пепел и искры), рамки и уголки на CSS, системные шрифты —
# никаких ассетов из игры. Антиква берётся из того, что установлено: Cinzel, Cormorant, EB Garamond,
# Palatino / TeX Gyre Pagella, иначе Georgia/serif.

@@ manifest
{
  "id": "ashen-inventory",
  "name": "Ashen Inventory",
  "author": "VK Music",
  "description": "Мрачный инвентарь: каменные панели, бронзовые рамки, слоты-ячейки и тлеющий пепел",
  "version": "1.0",
  "base": "royal",
  "apps": ["whisper-music"],
  "created": "2026-10-29T00:00:00Z",
  "preview": "asset:preview.jpg"
}

@@ tokens
{
  "color": {
    "accent": "#e6dab4",      // бледное золото — подсветка выбранного
    "accent2": "#a8834a",     // старая бронза — рамки и кнопки
    "text": "#d3c9b0",        // пергамент
    "muted": "#8a8170",
    "background": "#0b0a09"
  },
  "effects": {
    "glow": 0,
    "panelOpacity": 0.86,
    "dim": 0.12,
    "backgroundBlur": 0
  },
  "font": {
    "body": "\"EB Garamond\", \"Cormorant Garamond\", \"Palatino Linotype\", \"TeX Gyre Pagella\", \"URW Palladio L\", Georgia, serif",
    "display": "\"Cinzel\", \"Cormorant SC\", \"Trajan Pro\", \"EB Garamond\", \"Palatino Linotype\", \"TeX Gyre Pagella\", Georgia, serif"
  }
}

@@ settings whisper-music
{
  "features": { "glow": false }
}

@@ css whisper-music
/* Разметка — Whisper (VK Music повторяет её), основа — «Королевский». Поверх неё — камень, бронза и слоты. */
:root {
  --heading: #ece1c0;
  --gold: #a8834a;
  --gold-dim: rgba(168, 131, 74, 0.42);
  --gold-faint: rgba(168, 131, 74, 0.16);
  --pale: rgba(230, 218, 180, 0.55);
  --hover: rgba(230, 218, 180, 0.05);
  --danger: #b5523b;
}

/* ── панели: тёмный камень, двойная бронзовая рамка, уголки ── */
.panel {
  border-radius: 0;
  background:
    radial-gradient(120% 90% at 50% 0%, rgba(40, 34, 26, 0.35), transparent 60%),
    linear-gradient(180deg, rgba(16, 14, 11, var(--panel-a)), rgba(7, 6, 5, var(--panel-a)));
  border: 1px solid var(--gold-dim);
  box-shadow: inset 0 0 0 3px rgba(0, 0, 0, 0.75), inset 0 0 0 4px var(--gold-faint), inset 0 0 40px rgba(0, 0, 0, 0.6), 0 10px 34px rgba(0, 0, 0, 0.75);
}
.side::before, .player::before {
  content: ""; position: absolute; inset: 5px; pointer-events: none;
  --c: rgba(214, 186, 128, 0.85);
  background:
    linear-gradient(var(--c), var(--c)) top left / 16px 1px no-repeat, linear-gradient(var(--c), var(--c)) top left / 1px 16px no-repeat,
    linear-gradient(var(--c), var(--c)) top right / 16px 1px no-repeat, linear-gradient(var(--c), var(--c)) top right / 1px 16px no-repeat,
    linear-gradient(var(--c), var(--c)) bottom left / 16px 1px no-repeat, linear-gradient(var(--c), var(--c)) bottom left / 1px 16px no-repeat,
    linear-gradient(var(--c), var(--c)) bottom right / 16px 1px no-repeat, linear-gradient(var(--c), var(--c)) bottom right / 1px 16px no-repeat;
}
.side, .player { position: relative; }

/* ── заголовки: антиква капителью ── */
.head h2, .similar h3, .card h3, .tbbrand, .lastAlbum b {
  font-family: var(--font-display); font-variant: small-caps; letter-spacing: .14em; color: var(--heading); text-shadow: 0 1px 0 #000;
}
.titlebar { background: linear-gradient(rgba(5, 4, 3, .85), rgba(5, 4, 3, 0)); }
.tbdot { border-radius: 0; transform: rotate(45deg); background: var(--accent2); box-shadow: 0 0 8px rgba(214, 160, 80, .55); }

/* ── меню слева: строки меню, ромб у выбранного ── */
.side .nav {
  position: relative; border-radius: 0; background: transparent; padding-left: 28px;
  font-family: var(--font-display); font-variant: small-caps; letter-spacing: .14em; color: var(--muted);
}
.side .nav::before {
  content: ""; position: absolute; left: 11px; top: 50%; width: 6px; height: 6px; margin-top: -3px;
  transform: rotate(45deg); border: 1px solid var(--gold-dim);
}
.side .nav:hover:not(.active) { background: var(--hover); color: var(--text); }
.side .nav.active {
  color: var(--heading); text-shadow: none; font-weight: 600;
  background: linear-gradient(90deg, rgba(230, 218, 180, .13), rgba(230, 218, 180, .02) 70%, transparent);
  box-shadow: inset 0 0 0 1px var(--pale), inset 0 0 14px rgba(230, 218, 180, .08);
}
.side .nav.active::before { background: var(--accent); border-color: var(--accent); box-shadow: 0 0 6px rgba(230, 218, 180, .7); }

/* ── список: строки как предметы, обложки как слоты ── */
.list li { border-radius: 0; border: 1px solid transparent; }
.list li:hover { background: var(--hover); border-color: var(--gold-faint); }
.list li.playing {
  background: linear-gradient(90deg, rgba(230, 218, 180, .11), rgba(230, 218, 180, .02) 75%, transparent);
  border-color: var(--pale); box-shadow: inset 0 0 18px rgba(230, 218, 180, .08);
}
.list li.playing .t { color: var(--heading); text-shadow: 0 0 10px rgba(230, 218, 180, .35); }
.list .a { font-style: italic; }
.list img, .cover, .simcard img, .lastAlbum img, .fcover {
  border-radius: 0; background: radial-gradient(circle at 50% 40%, #17140f, #050404 75%);
  border: 1px solid var(--gold-dim); box-shadow: inset 0 0 0 2px #000, inset 0 0 10px rgba(0, 0, 0, .9);
}

/* ── поля и кнопки: прямоугольные, бронзовая волосяная линия ── */
.search, .field {
  border-radius: 0; background: linear-gradient(180deg, rgba(0, 0, 0, .55), rgba(12, 10, 8, .55));
  border: 1px solid var(--gold-dim); box-shadow: inset 0 1px 6px rgba(0, 0, 0, .8);
}
.search:focus, .field:focus { border-color: var(--accent); box-shadow: inset 0 1px 6px rgba(0, 0, 0, .8), 0 0 8px rgba(230, 218, 180, .15); }
.main .nav, .settings .nav, .chip {
  border-radius: 0; font-family: var(--font-display); font-variant: small-caps; letter-spacing: .12em;
  background: linear-gradient(180deg, rgba(36, 30, 22, .9), rgba(14, 12, 9, .9)); border: 1px solid var(--gold-dim); color: var(--text);
}
.main .nav.active, .settings .nav.active, .chip.active {
  background: linear-gradient(180deg, #3a2f1f, #1a150e); border-color: var(--gold); color: var(--heading); text-shadow: none; box-shadow: none;
}
.card, .lastAlbum, .simcard, .stylecard, .tmenu, .toast, .qpanel, .volpop, .login-box { border-radius: 0; border-color: var(--gold-dim); }

/* ── плеер: ромб-кнопка и ромб-ползунок ── */
.player .playbtn, .fbtns .playbtn {
  border-radius: 0; transform: rotate(45deg); background: linear-gradient(135deg, #3a2f1f, #120f0a);
  border: 1px solid var(--gold); color: var(--heading); box-shadow: 0 0 12px rgba(214, 160, 80, .25);
}
.player .playbtn svg, .fbtns .playbtn svg, .player .playbtn .ic, .fbtns .playbtn .ic { transform: rotate(-45deg); }
.player .playbtn:active { transform: rotate(45deg) scale(.94); }
.wavebtn { border-radius: 0; transform: rotate(45deg); background: linear-gradient(135deg, #3a2f1f, #120f0a); border: 1px solid var(--gold); color: var(--heading); }
.wavebtn svg { transform: rotate(-45deg); }
input[type=range]::-webkit-slider-runnable-track { height: 2px; border-radius: 0; background: linear-gradient(90deg, var(--accent2), var(--accent) var(--p, 0%), var(--gold-faint) var(--p, 0%)); }
input[type=range]::-webkit-slider-thumb { width: 9px; height: 9px; margin-top: -3.5px; border-radius: 0; transform: rotate(45deg); background: var(--accent); box-shadow: 0 0 8px rgba(230, 218, 180, .7); }
/* кружок на полосе трека VK Music (свой элемент, не родной кружок ползунка) */
.seekdot { width: 9px; height: 9px; border-radius: 0; transform: rotate(45deg); background: var(--accent); box-shadow: 0 0 8px rgba(230, 218, 180, .7); }
.time { font-variant: small-caps; letter-spacing: .08em; }
::selection { background: rgba(168, 131, 74, .45); color: #fff6dc; }

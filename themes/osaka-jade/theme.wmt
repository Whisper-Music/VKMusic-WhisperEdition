#WMT 1
# Osaka Jade — тема по умолчанию для VK Music.
# Палитра и обои — из темы Omarchy «Osaka Jade» (последняя версия перед заменой на Jade Horse,
# basecamp/omarchy@a1ea6096d^, themes/osaka-jade). Обои: backgrounds/1-glowing-city.webp.
# Формат: docs/WMT-FORMAT.md из Whisper-Music/YandexMusic-WhisperEdition.
# Править: переименовать в .zip, распаковать, поправить этот файл или заменить background.webp,
# запаковать обратно в .wmt и поменять manifest.id (встроенный id занят).

@@ manifest
{
  "id": "osaka-jade",
  "name": "Osaka Jade",
  "author": "Omarchy",
  "description": "Нефритовая ночь Осаки: тёмно-зелёные панели, мятный акцент, обои Glowing City",
  "version": "1.0",
  "base": "neon",
  "apps": ["whisper-music"],
  "created": "2026-10-29T00:00:00Z",
  "preview": "asset:preview.jpg"
}

@@ tokens
{
  "color": {
    "accent": "#2dd5b7",      // cyan — свечение нефрита
    "accent2": "#509475",     // accent из colors.toml Omarchy
    "text": "#c1c497",        // foreground
    "muted": "#81b8a8",       // dark_foreground
    "background": "#111c18"   // background
  },
  "effects": {
    "glow": 0,
    "panelOpacity": 0.74,
    "dim": 0.28,
    "backgroundBlur": 0
  },
  "font": {
    "body": "\"JetBrainsMono Nerd Font\", \"JetBrains Mono\", \"Fira Code\", monospace",
    "display": "\"JetBrainsMono Nerd Font\", \"JetBrains Mono\", monospace"
  }
}

@@ settings whisper-music
{
  "features": { "glow": false }
}

@@ css whisper-music
/* Разметка — Whisper (VK Music повторяет её): плитки как в Hyprland, рамки lighter_background, акцент — нефрит. */
:root {
  --heading: #f7e8b2;          /* bright_foreground */
  --selection: #32473b;
  --line: #23372b;             /* lighter_background */
  --surface: #0c1512;          /* dark_background */
  --hover: rgba(80, 148, 117, 0.16);
  --danger: #ff5345;
}
.panel { border-radius: 0; border: 2px solid var(--line); box-shadow: none; background: rgba(12, 21, 18, var(--panel-a)); }
.player.panel { border-color: #509475; }
.titlebar { background: rgba(9, 15, 13, .88); border-bottom: 1px solid var(--line); }
.tbdot { border-radius: 0; background: var(--accent); box-shadow: none; }
.tbbrand { color: var(--accent); letter-spacing: .14em; text-transform: lowercase; }

.head h2 { color: var(--heading); text-shadow: none; letter-spacing: .03em; }
.side .nav { border-radius: 0; background: transparent; }
.side .nav:hover:not(.active) { background: var(--hover); }
.side .nav.active { background: var(--selection); color: var(--heading); text-shadow: none; box-shadow: inset 3px 0 0 var(--accent); }

.search, .field { border-radius: 0; background: rgba(9, 15, 13, .78); border: 1px solid var(--line); }
.search:focus, .field:focus { border-color: #509475; box-shadow: 0 0 0 1px #509475; }

.list li { border-radius: 0; }
.list li:hover { background: var(--hover); }
.list li.playing { background: rgba(50, 71, 59, .55); }
.list li.playing .t { color: var(--accent); text-shadow: none; }
.list img, .cover, .simcard img, .lastAlbum img, .fcover { border-radius: 0; }

.card, .lastAlbum, .simcard, .stylecard, .chip, .nav, .tmenu, .toast, .login-box, .qpanel, .volpop { border-radius: 0; }
.nav.active, .chip.active, .player .playbtn, .wavebtn, .fbtns .playbtn { background: #509475; color: #090f0d; box-shadow: none; text-shadow: none; }
.player .playbtn:hover, .nav.active:hover { background: var(--accent); filter: none; }
.player button { border-radius: 0; }
.wavebtn { border-radius: 0; }
.modebtn.on, .likebtn.on { color: var(--accent); filter: none; }

input[type=range]::-webkit-slider-runnable-track { background: linear-gradient(90deg, #509475, var(--accent) var(--p, 0%), var(--line) var(--p, 0%)); border-radius: 0; }
input[type=range]::-webkit-slider-thumb { border-radius: 0; box-shadow: none; background: var(--heading); }
::selection { background: var(--selection); color: var(--heading); }

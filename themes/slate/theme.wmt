#WMT 1
# Грифель — базовая палитра VK Music (фиолетовый и розовый акценты на почти чёрном) поверх школьной доски
# со стёртым мелом. Фон нарисован процедурно (numpy + Pillow): разводы тряпкой, бледные нотные станы, зерно.

@@ manifest
{
  "id": "slate",
  "name": "Грифель",
  "author": "VK Music",
  "description": "Тёмные стеклянные панели с фиолетовым акцентом поверх школьной доски со стёртым мелом",
  "version": "1.0",
  "base": "neon",
  "apps": ["whisper-music"],
  "created": "2026-10-30T00:00:00Z",
  "preview": "asset:preview.jpg"
}

@@ tokens
{
  "color": {
    "accent": "#8b5cf6",
    "accent2": "#ec4899",
    "text": "#e8e6f0",
    "muted": "#9a97a8",
    "background": "#0f0e14"
  },
  "effects": {
    "glow": 0,
    "panelOpacity": 0.85,
    "dim": 0.3,
    "backgroundBlur": 3
  }
}

@@ settings whisper-music
{
  "features": { "glow": false }
}

@@ css whisper-music
/* Разметка — Whisper (VK Music повторяет её). Основа — «Неон» без свечения: стеклянные панели поверх школьной доски. */
.panel { -webkit-backdrop-filter: blur(14px) saturate(130%); backdrop-filter: blur(14px) saturate(130%); }
.head h2 { text-shadow: 0 2px 6px rgba(0, 0, 0, .45); }

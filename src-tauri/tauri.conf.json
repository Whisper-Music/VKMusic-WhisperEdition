{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VK Music",
  "version": "0.1.5",
  "identifier": "vkmusic-whisper",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VK Music",
        "width": 1280,
        "height": 820,
        "minWidth": 860,
        "minHeight": 560,
        "dragDropEnabled": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' blob:",
        "img-src": "'self' data: blob: vkm: http://vkm.localhost wa: http://wa.localhost https://*.userapi.com https://*.vkuserphoto.ru https://*.vk.me https://*.vk.com https://*.vk.ru https://*.sndcdn.com https://raw.githubusercontent.com https://*.yandex.net https://cdn.discordapp.com",
        "media-src": "'self' blob: vkm: http://vkm.localhost wa: http://wa.localhost",
        "font-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost vkm: http://vkm.localhost wa: http://wa.localhost blob: data:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "category": "Music",
    "shortDescription": "VK Music Whisper Edition",
    "longDescription": "Музыкальный плеер: ВКонтакте, SoundCloud, свои файлы, темы Whisper",
    "licenseFile": "../LICENSE",
    "linux": {
      "deb": {
        "desktopTemplate": "../packaging/vkmusic.desktop",
        "depends": [
          "mpv",
          "ffmpeg"
        ],
        "recommends": [
          "libayatana-appindicator3-1",
          "yt-dlp",
          "python3-mutagen"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["whisper"]
      }
    }
  }
}

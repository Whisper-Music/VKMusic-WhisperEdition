{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VK Music",
  "version": "0.1.0",
  "identifier": "ru.bobrik.vkmusic",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VK Music",
        "width": 1280,
        "height": 820,
        "minWidth": 860,
        "minHeight": 560,
        "dragDropEnabled": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["whisper"]
      }
    }
  }
}

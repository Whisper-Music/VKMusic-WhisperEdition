{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VK Music",
  "version": "0.1.1",
  "identifier": "vkmusic-whisper",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VK Music",
        "width": 1280,
        "height": 820,
        "minWidth": 860,
        "minHeight": 560,
        "dragDropEnabled": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "category": "Music",
    "shortDescription": "VK Music Whisper Edition",
    "longDescription": "Музыкальный плеер: ВКонтакте, SoundCloud, свои файлы, темы Whisper",
    "licenseFile": "../LICENSE",
    "linux": {
      "deb": {
        "desktopTemplate": "../packaging/vkmusic.desktop",
        "depends": [
          "mpv",
          "ffmpeg"
        ],
        "recommends": [
          "yt-dlp",
          "python3-mutagen"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["whisper"]
      }
    }
  }
}
